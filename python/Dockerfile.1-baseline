# ACT 1 — BASELINE: upstream base image + library from PyPI.
# This is where most teams start today.
#
# Diff this file against Dockerfile.2-image: the ONLY difference is the FROM line.
FROM python:3.14

WORKDIR /app
COPY app/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt
COPY app/ .

EXPOSE 8080
ENTRYPOINT ["python", "app.py"]
